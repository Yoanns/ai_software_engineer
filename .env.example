# Configure at least one provider. Never commit your real .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_API_KEY is still accepted for existing installations.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank for a temporary, single-worker development session key.
FLASK_SECRET_KEY=
# Set true only when serving the app over HTTPS.
SESSION_COOKIE_SECURE=false

API_TIMEOUT=120
MAX_OUTPUT_TOKENS=8192
MEMORY_DB_PATH=memory.db
LOG_LEVEL=INFO

# Optional local instruction-tuned GGUF files; install requirements-local.txt.
DEEPSEEK_MODEL_PATH=
LLAMA_MODEL_PATH=
THREADS=4
LOCAL_CONTEXT_SIZE=8192
LOCAL_MAX_TOKENS=2048
LOCAL_GPU_LAYERS=0
# Usually leave blank to use the chat template embedded in the GGUF file.
LOCAL_CHAT_FORMAT=

# DANGER: generated code has filesystem/network access if enabled.
# Use only in a disposable environment without secrets. Not a sandbox.
ALLOW_CODE_EXECUTION=false
TEST_TIMEOUT=5
